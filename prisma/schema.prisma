// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  employee
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  email    String @unique
  password String
  role     Role   @default(employee)

  office_id String @db.Uuid

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  assignments Assignments[]
  office      Office        @relation(fields: [office_id], references: [id], onDelete: Restrict)
}

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  equipment Equipment[]
}

model Office {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  building String
  floor    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment[]
  Employees User[]
}

model Equipment {
  id            String   @id @default(uuid()) @db.Uuid
  serial_number String   @unique
  brand         String
  model         String
  category_id   String   @db.Uuid
  office_id     String   @db.Uuid
  status        Status
  purchase_date DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category        Category           @relation(fields: [category_id], references: [id])
  office          Office             @relation(fields: [office_id], references: [id], onDelete: Restrict)
  assignments     Assignments[]
  maintenanceLogs Maintenance_logs[]
}

enum Status {
  in_stock
  in_use
  in_repair
  retired
}

model Assignments {
  id           String    @id @default(uuid()) @db.Uuid
  equipment_id String    @db.Uuid
  assigned_to  String    @db.Uuid
  assigned_at  DateTime  @default(now())
  returned_at  DateTime?

  user      User      @relation(fields: [assigned_to], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade)
}

enum MaintenanceStatus {
  open
  in_progress
  completed
  canceled
}

model Maintenance_logs {
  id           String            @id @default(uuid()) @db.Uuid
  equipment_id String            @db.Uuid
  description  String
  status       MaintenanceStatus @default(open)
  cost         Decimal?          @db.Decimal(10, 2)
  opened_at    DateTime          @default(now())
  completed_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment @relation(fields: [equipment_id], references: [id], onDelete: Restrict)
}
